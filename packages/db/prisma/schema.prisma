generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaperStatus {
  UPLOADED
  PARSING
  EMBEDDING
  READY
  FAILED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum JobType {
  PARSE_PAPER
  EMBED_PAPER
  RETRY_PAPER
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ChatScopeType {
  PAPER
  COLLECTION
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  papers        Paper[]
  chatSessions  ChatSession[]
  researchNotes ResearchNote[]
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  sessionTokenHash String    @unique
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime?
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Paper {
  id                 String      @id @default(uuid()) @db.Uuid
  userId             String      @db.Uuid
  title              String?
  abstract           String?
  publicationYear    Int?
  venue              String?
  doi                String?
  sourceUrl          String?
  originalFileName   String
  storageKey         String
  fileSha256         String
  pageCount          Int?
  status             PaperStatus @default(UPLOADED)
  statusMessage      String?
  metadataConfidence Float?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  authors           PaperAuthor[]
  pages             PaperPage[]
  sections          PaperSection[]
  chunks            PaperChunk[]
  references        PaperReference[]
  chatSessionPapers ChatSessionPaper[]
  chatCitations     ChatCitation[]
  researchCitations ResearchNoteCitation[]
  jobs              Job[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([fileSha256])
}

model PaperAuthor {
  id       String @id @default(uuid()) @db.Uuid
  paperId  String @db.Uuid
  name     String
  position Int

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId, position])
}

model PaperPage {
  id         String   @id @default(uuid()) @db.Uuid
  paperId    String   @db.Uuid
  pageNumber Int
  text       String
  charCount  Int
  createdAt  DateTime @default(now())

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, pageNumber])
}

model PaperSection {
  id              String @id @default(uuid()) @db.Uuid
  paperId         String @db.Uuid
  title           String
  normalizedTitle String
  startPage       Int?
  endPage         Int?
  position        Int

  paper  Paper        @relation(fields: [paperId], references: [id], onDelete: Cascade)
  chunks PaperChunk[]

  @@index([paperId, position])
}

model PaperChunk {
  id              String                       @id @default(uuid()) @db.Uuid
  paperId         String                       @db.Uuid
  sectionId       String?                      @db.Uuid
  chunkIndex      Int
  text            String
  tokenCount      Int
  startPage       Int
  endPage         Int
  charStart       Int?
  charEnd         Int?
  pageTextOffsets Json?
  contentHash     String
  chunkVersion    Int
  embedding       Unsupported("vector(1536)")?
  embeddingModel  String
  createdAt       DateTime                     @default(now())

  paper                 Paper                  @relation(fields: [paperId], references: [id], onDelete: Cascade)
  section               PaperSection?          @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  chatCitations         ChatCitation[]
  researchNoteCitations ResearchNoteCitation[]

  @@index([paperId, chunkIndex])
  @@index([paperId, chunkVersion])
  @@index([paperId, contentHash])
}

model PaperReference {
  id          String  @id @default(uuid()) @db.Uuid
  paperId     String  @db.Uuid
  rawText     String
  title       String?
  authorsText String?
  year        Int?
  venue       String?
  doi         String?
  position    Int

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId, position])
}

model ChatSession {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  title     String?
  scopeType ChatScopeType
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  papers   ChatSessionPaper[]
  messages ChatMessage[]
}

model ChatSessionPaper {
  id            String @id @default(uuid()) @db.Uuid
  chatSessionId String @db.Uuid
  paperId       String @db.Uuid

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  paper       Paper       @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([chatSessionId, paperId])
}

model ChatMessage {
  id                String        @id @default(uuid()) @db.Uuid
  chatSessionId     String        @db.Uuid
  role              ChatRole
  status            MessageStatus
  content           String
  model             String?
  promptVersion     String?
  temperature       Float?
  retrievalMetadata Json?
  providerRequestId String?
  llmTraceId        String?
  errorCode         String?
  createdAt         DateTime      @default(now())

  chatSession ChatSession      @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  citations   ChatCitation[]
  citedClaims ChatCitedClaim[]

  @@index([chatSessionId, createdAt])
}

model ChatCitation {
  id            String  @id @default(uuid()) @db.Uuid
  chatMessageId String  @db.Uuid
  paperId       String  @db.Uuid
  chunkId       String  @db.Uuid
  pageStart     Int
  pageEnd       Int
  quote         String?
  label         String

  chatMessage ChatMessage @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  paper       Paper       @relation(fields: [paperId], references: [id], onDelete: Cascade)
  chunk       PaperChunk  @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([chatMessageId])
}

model ChatCitedClaim {
  id            String @id @default(uuid()) @db.Uuid
  chatMessageId String @db.Uuid
  claimText     String
  citationIds   Json
  position      Int

  chatMessage ChatMessage @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)

  @@index([chatMessageId, position])
}

model ResearchNote {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  title           String
  contentMarkdown String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  citations ResearchNoteCitation[]
}

model ResearchNoteCitation {
  id             String  @id @default(uuid()) @db.Uuid
  researchNoteId String  @db.Uuid
  paperId        String  @db.Uuid
  chunkId        String? @db.Uuid
  pageStart      Int
  pageEnd        Int
  quote          String?

  researchNote ResearchNote @relation(fields: [researchNoteId], references: [id], onDelete: Cascade)
  paper        Paper        @relation(fields: [paperId], references: [id], onDelete: Cascade)
  chunk        PaperChunk?  @relation(fields: [chunkId], references: [id], onDelete: SetNull)
}

model Job {
  id              String    @id @default(uuid()) @db.Uuid
  type            JobType
  status          JobStatus @default(QUEUED)
  paperId         String?   @db.Uuid
  payload         Json
  attempts        Int       @default(0)
  maxAttempts     Int       @default(3)
  errorMessage    String?
  lockedAt        DateTime?
  lockedBy        String?
  runAfter        DateTime  @default(now())
  lastHeartbeatAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  startedAt       DateTime?
  finishedAt      DateTime?

  paper Paper? @relation(fields: [paperId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([status, runAfter])
  @@index([lockedAt])
}
