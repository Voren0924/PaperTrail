generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  papers        Paper[]
  chatSessions  ChatSession[]
  researchNotes ResearchNote[]
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  sessionTokenHash String    @unique
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime?
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Paper {
  id                 String   @id @default(uuid())
  userId             String   @default("local")
  title              String?
  abstract           String?
  publicationYear    Int?
  venue              String?
  doi                String?
  sourceUrl          String?
  originalFileName   String
  storageKey         String
  fileSha256         String
  mimeType           String   @default("application/pdf")
  pageCount          Int?
  status             String   @default("UPLOADED")
  statusMessage      String?
  metadataConfidence Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  authors           PaperAuthor[]
  pages             PaperPage[]
  sections          PaperSection[]
  chunks            PaperChunk[]
  references        PaperReference[]
  chatSessionPapers ChatSessionPaper[]
  chatCitations     ChatCitation[]
  researchCitations ResearchNoteCitation[]
  jobs              Job[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([fileSha256])
}

model PaperAuthor {
  id       String @id @default(uuid())
  paperId  String
  name     String
  position Int

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId, position])
}

model PaperPage {
  id         String   @id @default(uuid())
  paperId    String
  pageNumber Int
  text       String
  charCount  Int
  createdAt  DateTime @default(now())

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, pageNumber])
}

model PaperSection {
  id              String @id @default(uuid())
  paperId         String
  title           String
  normalizedTitle String
  startPage       Int?
  endPage         Int?
  position        Int

  paper  Paper        @relation(fields: [paperId], references: [id], onDelete: Cascade)
  chunks PaperChunk[]

  @@index([paperId, position])
}

model PaperChunk {
  id              String   @id @default(uuid())
  paperId         String
  sectionId       String?
  chunkIndex      Int
  text            String
  tokenCount      Int
  startPage       Int
  endPage         Int
  charStart       Int?
  charEnd         Int?
  pageTextOffsets Json?
  contentHash     String
  chunkVersion    Int
  embeddingModel  String   @default("pending")
  createdAt       DateTime @default(now())

  paper                 Paper                  @relation(fields: [paperId], references: [id], onDelete: Cascade)
  section               PaperSection?          @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  embeddings            Embedding[]
  chatCitations         ChatCitation[]
  researchNoteCitations ResearchNoteCitation[]

  @@index([paperId, chunkIndex])
  @@index([paperId, chunkVersion])
  @@index([paperId, contentHash])
}

model Embedding {
  id         String   @id @default(uuid())
  chunkId    String
  provider   String
  model      String
  dimensions Int
  vectorJson String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  chunk PaperChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([chunkId, provider, model])
  @@index([provider, model])
}

model PaperReference {
  id          String  @id @default(uuid())
  paperId     String
  rawText     String
  title       String?
  authorsText String?
  year        Int?
  venue       String?
  doi         String?
  position    Int

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId, position])
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String   @default("local")
  title     String?
  scopeType String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  papers   ChatSessionPaper[]
  messages ChatMessage[]
}

model ChatSessionPaper {
  id            String @id @default(uuid())
  chatSessionId String
  paperId       String

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  paper       Paper       @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([chatSessionId, paperId])
}

model ChatMessage {
  id                String   @id @default(uuid())
  chatSessionId     String
  role              String
  status            String
  content           String
  model             String?
  promptVersion     String?
  temperature       Float?
  retrievalMetadata Json?
  providerRequestId String?
  llmTraceId        String?
  errorCode         String?
  createdAt         DateTime @default(now())

  chatSession ChatSession      @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  citations   ChatCitation[]
  citedClaims ChatCitedClaim[]

  @@index([chatSessionId, createdAt])
}

model ChatCitation {
  id            String  @id @default(uuid())
  chatMessageId String
  paperId       String
  chunkId       String
  pageStart     Int
  pageEnd       Int
  quote         String?
  label         String

  chatMessage ChatMessage @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  paper       Paper       @relation(fields: [paperId], references: [id], onDelete: Cascade)
  chunk       PaperChunk  @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([chatMessageId])
}

model ChatCitedClaim {
  id            String @id @default(uuid())
  chatMessageId String
  claimText     String
  citationIds   Json
  position      Int

  chatMessage ChatMessage @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)

  @@index([chatMessageId, position])
}

model ResearchNote {
  id              String   @id @default(uuid())
  userId          String   @default("local")
  title           String
  contentMarkdown String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  citations ResearchNoteCitation[]
}

model ResearchNoteCitation {
  id             String  @id @default(uuid())
  researchNoteId String
  paperId        String
  chunkId        String?
  pageStart      Int
  pageEnd        Int
  quote          String?

  researchNote ResearchNote @relation(fields: [researchNoteId], references: [id], onDelete: Cascade)
  paper        Paper        @relation(fields: [paperId], references: [id], onDelete: Cascade)
  chunk        PaperChunk?  @relation(fields: [chunkId], references: [id], onDelete: SetNull)
}

model Job {
  id              String    @id @default(uuid())
  type            String
  status          String    @default("QUEUED")
  paperId         String?
  payload         Json
  attempts        Int       @default(0)
  maxAttempts     Int       @default(3)
  errorMessage    String?
  lockedAt        DateTime?
  lockedBy        String?
  runAfter        DateTime  @default(now())
  lastHeartbeatAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  startedAt       DateTime?
  finishedAt      DateTime?

  paper Paper? @relation(fields: [paperId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([status, runAfter])
  @@index([lockedAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
